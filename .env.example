# Copy this file to `.env` for `npm run dev` (apps on your machine).
# `docker compose up --build` already has working defaults and does not need this file.
# Change the JWT secrets before you put the app on the internet.

# ---- Frontend (http://127.0.0.1:4173) ----
FRONTEND_PORT=4173
# 127.0.0.1 keeps the page on this computer. Docker Compose sets 0.0.0.0 inside the container.
WEB_BIND=127.0.0.1
# Comma-separated Host headers allowed to open the page. Use * behind a public reverse proxy.
WEB_HOSTS=127.0.0.1,localhost,::1
# Where the page's /api proxy sends requests. Docker Compose overrides these with service names.
AUTH_HOST=127.0.0.1
STREAMS_HOST=127.0.0.1
CONTENT_HOST=127.0.0.1

# ---- Shared ----
CORS_ORIGIN=http://127.0.0.1:4173,http://localhost:4173
# Set LOCAL_BIND=127.0.0.1 only if you want the APIs on loopback AND you have already
# created ~/.pulseplay-local/audit.key (see local/README.md). With that bind address,
# register and stream start write an encrypted local journal and fail if the key is missing.
# Leave it unset for the normal first-time setup.
# LOCAL_BIND=127.0.0.1

# ---- Auth (MongoDB) ----
AUTH_PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/buttblastr_auth
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Mongo user id allowed to create OBS (source "obs") streams. Browser streams do not need this.
# OPERATOR_USER_ID=

# ---- Chat (Redis) ----
CHAT_PORT=4001
REDIS_URL=redis://127.0.0.1:6379

# ---- Streams (Postgres) ----
STREAMS_PORT=4002
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=buttblastr
PGUSER=postgres
PGPASSWORD=postgres_password
# Optional MediaMTX control URL. Leave unset to list streams from Postgres only.
# MEDIA_CONTROL_URL=http://127.0.0.1:9997

# ---- Content (MongoDB) ----
CONTENT_PORT=4003
CONTENT_MONGO_URI=mongodb://127.0.0.1:27017/buttblastr_content
